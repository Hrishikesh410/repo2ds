{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@repo2ds/core": ["packages/core/src/index.ts"],
      "@repo2ds/react": ["packages/react/src/index.ts"],
      "@repo2ds/react-native": ["packages/react-native/src/index.ts"],
      "@repo2ds/tailwind": ["packages/tailwind/src/index.ts"],
      "@repo2ds/nativewind": ["packages/nativewind/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "packages/*/dist", "fixtures"]
}
