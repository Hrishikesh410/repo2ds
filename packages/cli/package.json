{
  "name": "repo2ds",
  "version": "0.1.0",
  "description": "Reverse-engineer a design system from an existing React or React Native codebase. Local, deterministic, no LLM.",
  "keywords": [
    "design-system",
    "design-tokens",
    "storybook",
    "react",
    "react-native",
    "tailwind",
    "static-analysis",
    "cli"
  ],
  "license": "MIT",
  "author": "Hrishikesh Joshi",
  "homepage": "https://github.com/Hrishikesh410/repo2ds#readme",
  "bugs": "https://github.com/Hrishikesh410/repo2ds/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hrishikesh410/repo2ds.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "repo2ds": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/copy-readme.mjs && npm run build"
  },
  "dependencies": {
    "@repo2ds/core": "0.1.0",
    "@repo2ds/nativewind": "0.1.0",
    "@repo2ds/react": "0.1.0",
    "@repo2ds/react-native": "0.1.0",
    "@repo2ds/tailwind": "0.1.0",
    "commander": "^14.0.2",
    "picocolors": "^1.1.1"
  }
}
